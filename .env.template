# =====================================================================
# MOTIS LEADFLOW - LOCAL ENVIRONMENT CONFIGURATION
# =====================================================================
--
# INSTRUCTIONS:
# 1. Copy this file and rename the copy to exactly: `.env`
# 2. Paste your private Supabase keys below (obtained from your Supabase dashboard settings -> API).
# 3. WARNING: Never commit your actual `.env` file to Git! 
#    It is already ignored by default to protect your credentials.
#
# =====================================================================

# Your Supabase Project URL (looks like https://xxxxxxxxxxxx.supabase.co)
SUPABASE_URL=your_supabase_project_url_here

# Your Supabase Secret  Key (BYPASSES Row Level Security - DO NOT expose publicly!)
# Located under Project Settings -> API Keys -> Publishable and secret API keys -> Secret keys
SUPABASE_SECRET_KEY=your_secret_key_here

# Your Google Gemini API Key (for the AI Quote Estimator chatbot)
# Get your FREE key from: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# =====================================================================
# NOTE: When deploying live on Netlify, you must also paste ALL THREE 
# keys into the "Environment Variables" section of your Netlify Site Settings!
# =====================================================================
